---
import { profile } from '../data/resume';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = profile.bio } = Astro.props;
const pageTitle = title ? `${title} · ${profile.name}` : profile.name;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/', label: 'About' },
  { href: '/publications', label: 'Publications' },
  { href: '/cv', label: 'CV' },
  { href: '/blog', label: 'Blog' },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const built = new Date().toISOString().slice(0, 10);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
    />
    <title>{pageTitle}</title>
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t) document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <div class="wrap">
      <header>
        <a href="/" class="brand">{profile.name}</a>
        <nav>
          {nav.map((n) => (
            <a href={n.href} class:list={{ active: isActive(n.href) }}>{n.label}</a>
          ))}
          <button class="theme" type="button" aria-label="Toggle color theme" title="Toggle theme">◐</button>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer>
        <span>© {new Date().getFullYear()} {profile.name}</span>
        <span>Last updated {built}</span>
      </footer>
    </div>
    <script is:inline>
      document.querySelector('.theme').addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme
          ? root.dataset.theme === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch (e) {}
        window.dispatchEvent(new Event('themechange'));
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbfbf9;
    --panel: #ffffff;
    --fg: #1c1d1f;
    --muted: #63666b;
    --faint: #9a9c9f;
    --line: #e5e4df;
    --accent: #0f7b5a;
    --accent-2: #2f5fb3;
    --hl: #b0450f;
    --code-bg: #efede6;
    color-scheme: light;
    --mono: 'JetBrains Mono', ui-monospace, 'SFMono-Regular', Consolas, monospace;
    --serif: 'Source Serif 4', 'Iowan Old Style', Georgia, 'Songti SC', serif;
    --sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      --bg: #0c0f12;
      --panel: #12161b;
      --fg: #e4e6e8;
      --muted: #9aa1a9;
      --faint: #5f666e;
      --line: #23292f;
      --accent: #7cc4a8;
      --accent-2: #8ab4f8;
      --hl: #e0a46e;
      --code-bg: #171c22;
      color-scheme: dark;
    }
  }
  :root[data-theme='dark'] {
    --bg: #0c0f12;
    --panel: #12161b;
    --fg: #e4e6e8;
    --muted: #9aa1a9;
    --faint: #5f666e;
    --line: #23292f;
    --accent: #7cc4a8;
    --accent-2: #8ab4f8;
    --hl: #e0a46e;
    --code-bg: #171c22;
    color-scheme: dark;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font: 17px/1.7 var(--serif);
    overflow-x: hidden;
  }
  .wrap { max-width: 1120px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 48px); }
  .mono, code, pre, .when { font-family: var(--mono); }

  .split { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 16px 64px; }
  .split + .split { margin-top: 56px; }
  .split > .label { margin: 0; padding-top: 4px; }
  @media (max-width: 820px) {
    .split { grid-template-columns: 1fr; gap: 12px; }
    .split + .split { margin-top: 40px; }
  }

  header {
    display: flex; flex-wrap: wrap; gap: 12px 24px; justify-content: space-between; align-items: center;
    padding: 24px 0; border-bottom: 1px solid var(--line);
  }
  .brand { color: var(--fg); text-decoration: none; font-weight: 600; font-size: 1.05rem; }
  nav { display: flex; flex-wrap: wrap; gap: 4px 20px; align-items: center; font-family: var(--sans); font-size: 0.92rem; }
  nav a { color: var(--muted); text-decoration: none; }
  nav a:hover, nav a.active { color: var(--fg); }
  .theme {
    background: none; border: 1px solid var(--line); color: var(--muted); border-radius: 4px;
    width: 28px; height: 28px; cursor: pointer; font-size: 0.9rem; line-height: 1;
  }
  .theme:hover { color: var(--accent); border-color: var(--accent); }
  @media (max-width: 480px) { nav { gap: 4px 14px; font-size: 0.85rem; } }

  main { padding: 56px 0 80px; }
  footer {
    border-top: 1px solid var(--line); padding: 24px 0 40px; color: var(--muted); font-size: 0.82rem;
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; font-family: var(--sans);
  }
  a { color: var(--accent-2); text-underline-offset: 3px; text-decoration-thickness: 1px; }
  h1 { font-size: 2.2rem; line-height: 1.2; margin: 0 0 12px; letter-spacing: -0.01em; font-weight: 600; }
  h2 {
    font-family: var(--sans); font-size: 0.8rem; margin: 56px 0 18px; text-transform: uppercase;
    letter-spacing: 0.08em; color: var(--muted); font-weight: 600;
    padding-bottom: 8px; border-bottom: 1px solid var(--line);
  }
  .muted { color: var(--muted); }
  code { background: var(--code-bg); padding: 0.12em 0.35em; border-radius: 4px; font-size: 0.86em; }
  pre { background: var(--code-bg); padding: 16px; border-radius: 6px; overflow-x: auto; font-size: 0.8rem; line-height: 1.6; border: 1px solid var(--line); }
  pre code { background: none; padding: 0; }
  img { max-width: 100%; }
  .tag { font-family: var(--sans); font-size: 0.8rem; color: var(--muted); }
  ::selection { background: var(--accent); color: var(--bg); }
</style>

---
import { profile } from '../data/resume';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = profile.bio } = Astro.props;
const pageTitle = title ? `${title} · ${profile.name}` : profile.name;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/', label: 'About' },
  { href: '/resume', label: 'Resume' },
  { href: '/blog', label: 'Blog' },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="wrap">
      <header>
        <a href="/" class="brand">{profile.name}</a>
        <nav>
          {nav.map((n) => (
            <a href={n.href} class:list={{ active: isActive(n.href) }}>{n.label}</a>
          ))}
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer>© {new Date().getFullYear()} {profile.name}</footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbfbfa;
    --fg: #1f2328;
    --muted: #6b7280;
    --line: #e5e7eb;
    --accent: #2563eb;
    --code-bg: #f3f4f6;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #111315;
      --fg: #e6e6e6;
      --muted: #9aa0a6;
      --line: #2a2d31;
      --accent: #6ea8fe;
      --code-bg: #1c1f23;
      color-scheme: dark;
    }
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font: 16px/1.7 -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif;
  }
  .wrap { max-width: 720px; margin: 0 auto; padding: 0 20px; }
  header {
    display: flex; flex-wrap: wrap; gap: 12px; justify-content: space-between; align-items: center;
    padding: 28px 0; border-bottom: 1px solid var(--line);
  }
  .brand { font-weight: 700; color: var(--fg); text-decoration: none; font-size: 1.05rem; }
  nav { display: flex; gap: 20px; }
  nav a { color: var(--muted); text-decoration: none; font-size: 0.95rem; }
  nav a:hover, nav a.active { color: var(--fg); }
  main { padding: 40px 0 64px; }
  footer { border-top: 1px solid var(--line); padding: 24px 0 40px; color: var(--muted); font-size: 0.85rem; }
  a { color: var(--accent); }
  h1 { font-size: 2rem; line-height: 1.25; margin: 0 0 12px; letter-spacing: -0.01em; }
  h2 { font-size: 1.15rem; margin: 48px 0 16px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); font-weight: 600; }
  .muted { color: var(--muted); }
  code { background: var(--code-bg); padding: 0.15em 0.35em; border-radius: 4px; font-size: 0.9em; }
  pre { padding: 16px; border-radius: 8px; overflow-x: auto; font-size: 0.88rem; }
  pre code { background: none; padding: 0; }
  img { max-width: 100%; }
</style>

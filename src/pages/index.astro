---
import Base from '../layouts/Base.astro';
import SdeFigure from '../components/SdeFigure.astro';
import PaperList from '../components/PaperList.astro';
import { profile, news, research, publications } from '../data/resume';
---
<Base>
  <section class="hero">
    <div class="intro">
      <h1>{profile.name}</h1>
      <p class="role muted">{profile.tagline} · {profile.location}</p>
      <p class="lead">{profile.bio}</p>
      <p class="email"><span class="muted">Email:</span> {profile.email}</p>
      <p class="links">
        {profile.links.map((l) => <a href={l.url}>{l.label}</a>)}
        <a href="/cv">CV</a>
      </p>
    </div>
    <SdeFigure />
  </section>

  <section>
    <h2>News</h2>
    <ul class="rows">
      {news.slice(0, 3).map((n) => (
        <li><span class="when">{n.date}</span><span set:html={n.text} /></li>
      ))}
    </ul>
  </section>

  <section>
    <h2>Research</h2>
    <div class="research">
      {research.map((r) => (
        <div class="topic">
          <h3>{r.title}</h3>
          <div class="muted small">{r.where}</div>
          <p>{r.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section>
    <h2>Publications</h2>
    <PaperList papers={publications} />
  </section>

</Base>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 56px; align-items: center; }
  .hero h1 { margin-bottom: 4px; }
  .role { font-family: var(--sans); font-size: 0.95rem; margin: 0 0 20px; }
  .lead { font-size: 1.1rem; margin: 0 0 16px; }
  .email { font-family: var(--sans); font-size: 0.95rem; margin: 0 0 8px; }
  .links { display: flex; flex-wrap: wrap; gap: 6px 20px; margin: 0; font-family: var(--sans); font-size: 0.95rem; }

  .rows { list-style: none; padding: 0; margin: 0; }
  .rows li { display: grid; grid-template-columns: 100px minmax(0, 1fr); gap: 4px 16px; padding: 8px 0; }
  .when { font-size: 0.8rem; color: var(--muted); padding-top: 3px; font-variant-numeric: tabular-nums; }
  .small { font-size: 0.9rem; }

  .research { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px; }
  h3 { font-size: 1.05rem; margin: 0 0 2px; line-height: 1.4; }
  .topic p { margin: 10px 0 0; font-size: 0.95rem; }

  @media (max-width: 960px) {
    .hero, .research { grid-template-columns: 1fr; }
    .hero { gap: 32px; }
    .research { gap: 24px; }
  }
  @media (max-width: 600px) { .rows li { grid-template-columns: 1fr; gap: 0; } }
</style>

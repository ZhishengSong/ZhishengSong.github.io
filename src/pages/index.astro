---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { profile, experience, education } from '../data/resume';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
const fmt = (d: Date) => d.toISOString().slice(0, 10);
const initials = profile.name.split(' ').map((w) => w[0]).join('');
---
<Base>
  <div class="home">
    <aside class="profile">
      <div class="avatar">{initials}</div>
      <h1>{profile.name}</h1>
      <p class="muted">{profile.tagline}</p>
      <p class="muted">{profile.location}</p>
      <ul class="links">
        <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
        {profile.links.map((l) => <li><a href={l.url}>{l.label}</a></li>)}
        <li><a href="/resume">Resume →</a></li>
      </ul>
    </aside>

    <div class="content">
      <section>
        <h2>About</h2>
        <p class="lead">{profile.bio}</p>
      </section>

      <section>
        <h2>Experience</h2>
        <ul class="timeline">
          {experience.map((x) => (
            <li>
              <span class="muted when">{x.period}</span>
              <div><strong>{x.org}</strong><div class="muted">{x.role}</div></div>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2>Education</h2>
        <ul class="timeline">
          {education.map((e) => (
            <li>
              <span class="muted when">{e.period}</span>
              <div><strong>{e.school}</strong><div class="muted">{e.degree}</div></div>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2>Recent writing</h2>
        {posts.length === 0 ? <p class="muted">Nothing yet.</p> : (
          <ul class="timeline">
            {posts.map((p) => (
              <li><span class="muted when">{fmt(p.data.date)}</span><a href={`/blog/${p.id}`}>{p.data.title}</a></li>
            ))}
          </ul>
        )}
        <p><a href="/blog">All posts →</a></p>
      </section>
    </div>
  </div>
</Base>

<style>
  .home { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 80px; align-items: start; }
  .profile { position: sticky; top: calc(env(safe-area-inset-top, 0px) + 32px); }
  .avatar {
    width: 88px; height: 88px; border-radius: 50%; display: grid; place-items: center;
    background: var(--fg); color: var(--bg); font-size: 1.6rem; font-weight: 700; margin-bottom: 20px;
  }
  .profile h1 { font-size: 1.8rem; }
  .profile p { margin: 4px 0; }
  .links { list-style: none; padding: 0; margin: 20px 0 0; display: grid; gap: 6px; }
  .links a { word-break: break-all; }
  .content h2 { margin-top: 48px; }
  .content section:first-child h2 { margin-top: 0; }
  .lead { font-size: 1.15rem; line-height: 1.75; margin: 0; }
  .timeline { list-style: none; padding: 0; margin: 0; }
  .timeline li { display: grid; grid-template-columns: 170px minmax(0, 1fr); gap: 4px 24px; padding: 10px 0; border-bottom: 1px solid var(--line); }
  .when { font-variant-numeric: tabular-nums; font-size: 0.9rem; padding-top: 2px; }
  @media (max-width: 820px) {
    .home { grid-template-columns: 1fr; gap: 40px; }
    .profile { position: static; }
    .timeline li { grid-template-columns: 1fr; }
  }
</style>

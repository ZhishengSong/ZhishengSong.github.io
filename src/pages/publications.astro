---
import Base from '../layouts/Base.astro';
import PaperList from '../components/PaperList.astro';
import { publications } from '../data/resume';
---
<Base title="Publications">
  <div class="page">
    <h1>Publications</h1>
    <p class="muted intro">Preprints and papers under review.</p>
    <PaperList papers={publications} open />
  </div>
</Base>

<style>
  .page { max-width: 820px; }
  .intro { margin: 0 0 36px; }
</style>

---
import Base from '../layouts/Base.astro';
import { profile, education, experience, projects, skills, awards } from '../data/resume';
---
<Base title="Resume">
  <div class="split head">
    <div></div>
    <div>
      <h1>Resume</h1>
      <p class="muted">{profile.tagline} · <a href={`mailto:${profile.email}`}>{profile.email}</a></p>
    </div>
  </div>

  <section class="split">
    <h2 class="label">Education</h2>
    <div>
      {education.map((e) => (
        <div class="item">
          <div class="row"><strong>{e.school}</strong><span class="muted">{e.period}</span></div>
          <div>{e.degree}</div>
          <div class="muted small">{e.detail}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="split">
    <h2 class="label">Experience</h2>
    <div>
      {experience.map((x) => (
        <div class="item">
          <div class="row"><strong>{x.org}</strong><span class="muted">{x.period}</span></div>
          <div class="muted">{x.role}</div>
          <ul>{x.points.map((p) => <li>{p}</li>)}</ul>
        </div>
      ))}
    </div>
  </section>

  <section class="split">
    <h2 class="label">Projects</h2>
    <div>
      {projects.map((p) => (
        <div class="item">
          <div class="row"><strong>{p.name}</strong><span class="muted">{p.period}</span></div>
          <div>{p.desc}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="split">
    <h2 class="label">Skills</h2>
    <div>{skills.map((s) => <p class="skill"><strong>{s.group}:</strong> {s.items}</p>)}</div>
  </section>

  <section class="split">
    <h2 class="label">Honors</h2>
    <div>
      {awards.map((a) => (
        <div class="row"><span>{a.name}</span><span class="muted">{a.period}</span></div>
      ))}
    </div>
  </section>
</Base>

<style>
  .head { margin-bottom: 56px; }
  .item { margin-bottom: 28px; }
  .item:last-child { margin-bottom: 0; }
  .row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 16px; }
  .small { font-size: 0.9rem; }
  ul { margin: 8px 0 0; padding-left: 20px; }
  li { margin: 4px 0; }
  .skill { margin: 0 0 8px; }
  @media (max-width: 820px) { .head > div:first-child { display: none; } }
</style>
